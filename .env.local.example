# Liftoff runs fully offline with no setup — your data is saved on this device.
# Cloud sync is OPTIONAL. To enable it, copy this file to `.env.local` and fill in
# your Supabase project credentials:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OPTIONAL: which account owns the coaching roster (the "Clients" tab and the
# Liftoff Templates workspace). Defaults to the built-in coach address.
# Comma-separate for more than one coach. Everyone else — including invited
# clients — never sees the roster.
# NOTE: Vite bakes VITE_* vars in at BUILD time, so changing this on your host
# (Vercel etc.) only takes effect after a redeploy.
VITE_COACH_EMAIL=

# OPTIONAL: web-push reminders. Set the VAPID *public* key here (the private
# key is a Supabase secret, never the client). See docs/PUSH_SETUP.md.
VITE_VAPID_PUBLIC_KEY=
